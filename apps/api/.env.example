# Copy to .env and fill in
DATABASE_URL=postgres://tasknest:tasknest@localhost:5432/tasknest
JWT_SECRET=change-me-to-at-least-32-random-characters
WEB_ORIGIN=http://localhost:3000
PORT=4000
LOG_LEVEL=info
# Leave empty locally (cookie is host-only); set to e.g. .tasknest.app in production
COOKIE_DOMAIN=
