# Copy to .env and fill in
DATABASE_URL=postgres://tasknest:tasknest@localhost:5432/tasknest
JWT_SECRET=change-me-to-at-least-32-random-characters
WEB_ORIGIN=http://localhost:3000
PORT=4000
LOG_LEVEL=info
# Leave empty locally (cookie is host-only); set to e.g. .tasknest.app in production
COOKIE_DOMAIN=

# --- Optional: Google sign-in (console.cloud.google.com > APIs & Services > Credentials)
# Authorised redirect URI: <WEB_ORIGIN>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: send invite emails with Resend (resend.com). Without a key, emails are printed in the API log.
RESEND_API_KEY=
EMAIL_FROM=TaskNest <onboarding@resend.dev>
